{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "../../",
        "strictPropertyInitialization": false,
        "types": ["node", "jest"],
        "paths": {
            "@/*": ["./src/*"],
            "@common/*": ["../../packages/common/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "**/*.e2e-spec.ts"]
}
