# ============================================================
# Biến môi trường của Order Service
# ============================================================
# Phạm vi sử dụng:
# - Sao chép file này thành services/order-service/.env khi chạy local.
# - Khi chạy Docker Compose, dùng hostname service trong docker-compose.yml.
# - Production phải inject password và token qua Secret Manager/Kubernetes Secret.
# ============================================================

# -----------------------------------------------------------------------------
# 01. Runtime - HTTP API và log TypeORM
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3011
TYPEORM_LOGGING=false

# -----------------------------------------------------------------------------
# 02. PostgreSQL - cơ sở dữ liệu riêng của Order Service
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bin_ecommerce
POSTGRES_PASSWORD=
POSTGRES_DB=bin_ecommerce_order

# -----------------------------------------------------------------------------
# 03. Service đồng bộ - checkout, người dùng, sản phẩm, shop và vận chuyển
# -----------------------------------------------------------------------------
# Khi chạy local, các service dùng port public/standalone tương ứng.
CART_SERVICE_URL=http://localhost:3010
AUTH_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3008
SELLER_SERVICE_URL=http://localhost:3007
SHIPPING_SERVICE_URL=http://localhost:3012
INTERNAL_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# 04. Kafka - publish order event và nhận shipment status
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=order-service
KAFKA_ORDER_GROUP_ID=order-service-shipment-sync-v3
KAFKA_PUBLISH_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# 05. Pay2S - đối soát webhook giao dịch tiền ra cho payout seller
# -----------------------------------------------------------------------------
# Token riêng của Hook Pay2S; SOURCE_ACCOUNT_NUMBER là accountNumber Pay2S trả về, có thể là mã P2S... hoặc số tài khoản.
# Pay2S chỉ báo giao dịch OUT; admin vẫn chuyển tiền từ app ngân hàng và xác minh người nhận trước khi chốt.
PAY2S_PAYOUT_WEBHOOK_TOKEN=
PAY2S_PAYOUT_SOURCE_ACCOUNT_NUMBER=
